config.signtool=/tmp/ohsign/hap-sign-tool.jar
config.targetDir=/tmp/ohsign
common.keyPwd=123456
common.keystorePwd=123456
app.keypair.keyAlias=app-key
app.keypair.keyAlg=ECC
app.keypair.keySize=NIST-P-256
app.keypair.keystoreFile=keys.p12
cert.app.keyAlias=app-key
cert.app.signAlg=SHA384withECDSA
cert.app.issuer=C=CN,O=OpenHarmony,OU=OpenHarmony Team,CN=OpenHarmony Application CA
cert.app.issuerKeyAlias=sub-ca-app
cert.app.issuerKeyPwd=123456
cert.app.subject=C=CN,O=OpenHarmony,OU=OpenHarmony Team,CN=OpenHarmony Application Release
cert.app.keystoreFile=keys.p12
cert.app.subCaCertFile=sub-ca-app.cer
cert.app.rootCaCertFile=root-ca.cer
cert.app.outForm=certChain
cert.app.outFile=app-cert.cer
sign.profile.keyAlias=profile-key
sign.profile.signAlg=SHA384withECDSA
sign.profile.mode=localSign
sign.profile.profileCertFile=profile-cert.cer
sign.profile.inFile=profile.json
sign.profile.keystoreFile=keys.p12
sign.profile.outFile=profile.p7b

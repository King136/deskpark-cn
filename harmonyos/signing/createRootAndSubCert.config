config.signtool=/tmp/ohsign/hap-sign-tool.jar
config.targetDir=/tmp/ohsign
common.keyPwd=123456
common.keystorePwd=123456
profile.keypair.keyAlias=profile-key
profile.keypair.keyAlg=ECC
profile.keypair.keySize=NIST-P-256
profile.keypair.keystoreFile=keys.p12
root-ca.keyAlias=root-ca
root-ca.signAlg=SHA384withECDSA
root-ca.keyAlg=ECC
root-ca.keySize=NIST-P-256
root-ca.subject=C=CN,O=OpenHarmony,OU=OpenHarmony Team,CN=OpenHarmony Application Root CA
root-ca.keystoreFile=keys.p12
root-ca.outFile=root-ca.cer
root-ca.basicConstraintsPathLen=2
sub-ca.app.keyAlias=sub-ca-app
sub-ca.app.signAlg=SHA384withECDSA
sub-ca.app.keyAlg=ECC
sub-ca.app.keySize=NIST-P-256
sub-ca.app.subject=C=CN,O=OpenHarmony,OU=OpenHarmony Team,CN=OpenHarmony Application CA
sub-ca.app.keystoreFile=keys.p12
sub-ca.app.outFile=sub-ca-app.cer
sub-ca.app.issuer=C=CN,O=OpenHarmony,OU=OpenHarmony Team,CN=OpenHarmony Application Root CA
sub-ca.app.issuerKeyAlias=root-ca
sub-ca.app.issuerKeyPwd=123456
sub-ca.app.basicConstraintsPathLen=1
sub-ca.profile.keyAlias=sub-ca-profile
sub-ca.profile.signAlg=SHA384withECDSA
sub-ca.profile.keyAlg=ECC
sub-ca.profile.keySize=NIST-P-256
sub-ca.profile.subject=C=CN,O=OpenHarmony,OU=OpenHarmony Team,CN=OpenHarmony Application Profile CA
sub-ca.profile.keystoreFile=keys.p12
sub-ca.profile.outFile=sub-ca-profile.cer
sub-ca.profile.issuer=C=CN,O=OpenHarmony,OU=OpenHarmony Team,CN=OpenHarmony Application Root CA
sub-ca.profile.issuerKeyAlias=root-ca
sub-ca.profile.issuerKeyPwd=123456
sub-ca.profile.basicConstraintsPathLen=1
cert.profile.keyAlias=profile-key
cert.profile.signAlg=SHA384withECDSA
cert.profile.issuer=C=CN,O=OpenHarmony,OU=OpenHarmony Team,CN=OpenHarmony Application Profile CA
cert.profile.issuerKeyAlias=sub-ca-profile
cert.profile.issuerKeyPwd=123456
cert.profile.subject=C=CN,O=OpenHarmony,OU=OpenHarmony Team,CN=OpenHarmony Application Profile
cert.profile.keystoreFile=keys.p12
cert.profile.subCaCertFile=sub-ca-profile.cer
cert.profile.rootCaCertFile=root-ca.cer
cert.profile.outForm=certChain
cert.profile.outFile=profile-cert.cer
